{
  "name": "error-handling",
  "version": "1.0.0",
  "private": true,
  "description": "Error handling patterns in TypeScript: validate at the edge, typed errors, one central handler, Result for expected outcomes",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "serve": "node src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "author": "Rick Waterman",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
